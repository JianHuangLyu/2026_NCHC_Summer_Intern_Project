# Copy only the variables you need to a local .env or export them in the shell.
# Never commit API keys, Hugging Face tokens, passwords, or OTP values.

PATHOVISION_PROJECT_DIR=/work/USERNAME/2026_NCHC_Summer_Intern_Project
PATHOVISION_SERVER_PYTHON=/work/USERNAME/2026_NCHC_Summer_Intern_Project/.venv/bin/python
PATHOVISION_VLLM_BIN=/absolute/path/to/vllm
PATHOVISION_STUDENT_MODEL_ROOT=/work/USERNAME/2026_NCHC_Summer_Intern_Project/Student_model
PATHOVISION_MODEL_PATH=/work/USERNAME/2026_NCHC_Summer_Intern_Project/Localization_model/yolo11m_best.pt
PATHOVISION_YOLO11S_MODEL_PATH=/work/USERNAME/2026_NCHC_Summer_Intern_Project/Localization_model/yolo11s_best.pt

# Generate at runtime with: python scripts/generate_api_key.py
# PATHOVISION_API_KEY=

# Optional Hugging Face authentication for gated model downloads.
# HF_TOKEN=

